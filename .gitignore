# —— 不上传：大文件 / 版权素材 / 中间产物 ——
*.mp4
*.mov
*.mkv
*.wav
*.mp3
*.m4a
*.prproj

# —— 明确不推送（用户要求）：本地原曲 + 第三方外源原片，整目录排除 ——
音频/
素材/外源视频/

# —— 成片 / 预览 / 示例镜头：体积大、可由素材与脚本重新渲染 ——
导出/
素材/示例镜头/
工程/示例镜头/
# 自己生成的 AI 镜头可以上传
!素材/AI镜头/*.mp4
node_modules/
*.log
*.err
*.b64
__pycache__/
工程/mg/stills_host/
工程/live2d/**/vendor/
工程/live2d/**/shot_*.png

# 系统 / 编辑器杂项
Thumbs.db
desktop.ini
.DS_Store
.vscode/
*.tmp

# —— 派生帧 / 本地备份 / 渲染中间件（可由 素材/AI镜头 与脚本重新生成）——
工程/mg/assets/clips/
工程/mg/_bak_v*/
工程/mg/assets/chars/_sil_v*/
工程/ae/render/
工程/ae/stills/
工程/ae/*日志/
# FlashVSR 超分成片可以上传（clips 帧由它们重新抽取）
!素材/AI镜头/超分测试/*.mp4
